class ParkingSystem {

    private int[] parking;

    public ParkingSystem(int big, int medium, int small) {
        parking = new int[4];

        parking[1] = big;
        parking[2] = medium;
        parking[3] = small;
    }

    public boolean addCar(int carType) {

        // Check if space is available
        if (parking[carType] > 0) {

            // Occupy one parking space
            parking[carType]--;

            return true;
        }

        return false;
    }
}
